+    sockets.add(socket);
+    /** @type {Promise<void>} */
+    const joined = new Promise((resolve) => {
+      socket.once("close", () => {
+        sockets.delete(socket);
+        joins.delete(joined);
+        resolve(undefined);
+      });
+    });
+    joins.add(joined);
+  };
+  /** @param {import("node:http").IncomingMessage} req @param {import("node:stream").Duplex} incoming @param {Buffer} head */
+  const upgrade = (req, incoming, head) => {
+    if (
+      !accepting ||
+      req.method !== "POST" ||
+      !/^\/(?:v[\d.]+\/)?exec\/[^/?]+\/start(?:\?.*)?$/.test(req.url ?? "")
+    ) {
+      incoming.destroy();
+      return;
+    }
+    incoming.pause();
+    incoming.allowHalfOpen = true;
+    own(incoming);
+    const upstream = new Socket({ allowHalfOpen: true });
+    own(upstream);
+    const abort = () => {
+      incoming.destroy();
+      upstream.destroy();
+    };
+    for (const socket of [incoming, upstream]) {
+      socket.on("error", abort);
+      socket.once("close", () => {
+        // A clean close must not truncate bytes queued on the other socket.
+        if (!socket.readableEnded || !socket.writableFinished) abort();
+      });
+    }
+    upstream.pipe(incoming);
+    upstream.once("connect", () => {
+      const lines = [`${req.method} ${req.url} HTTP/${req.httpVersion}`];
+      for (let i = 0; i < req.rawHeaders.length; i += 2) {
+        lines.push(`${req.rawHeaders[i]}: ${req.rawHeaders[i + 1]}`);
+      }
+      upstream.write(`${lines.join("\r\n")}\r\n\r\n`, "latin1");
+      if (head.length) upstream.write(head);
+      const relay = () => incoming.pipe(upstream);
+      if (upstream.writableNeedDrain) upstream.once("drain", relay);
+      else relay();
+    });
+    try {
+      upstream.connect({ path: socketPath.replace(/^unix:/, "") });
+    } catch {
+      abort();
+    }
+  };
+  server.on("upgrade", upgrade);
+  return async () => {
+    accepting = false;
+    // Keep the rejecting listener until server.close stops new connections.
+    const pending = [...joins];
+    for (const socket of sockets) socket.destroy();
+    await Promise.all(pending);
+  };
+}
+/** @param {import("node:http").Server} server @param {string} socketPath */
+export async function acquireDockerProxy(server, socketPath) {
+  const stop = installDockerExecUpgrade(server, socketPath);
+  const close = async () => {
+    await stop();
+    await new Promise((resolve) => server.close(() => resolve(undefined)));
+  };
+  try {
+    await new Promise((resolve, reject) => {
+      server.once("error", reject);
+      server.listen(0, () => {
+        server.removeListener("error", reject);
+        resolve(undefined);
+      });
+    });
+    return { server, close };
+  } catch (error) {
+    await close();
+    throw error;
+  }
+}
