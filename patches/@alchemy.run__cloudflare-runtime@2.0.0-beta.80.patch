+import { Socket } from "node:net";
+/** @param {import("node:http").Server} server @param {string} socketPath */
+function installDockerExecUpgrade(server, socketPath) {
+  /** @type {Set<import("node:stream").Duplex>} */
+  const sockets = new Set();
+  /** @type {Set<Promise<void>>} */
