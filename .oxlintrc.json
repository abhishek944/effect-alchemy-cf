{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn", "oxc"],
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/consistent-type-imports": "error",
    "eqeqeq": "error",
    "no-underscore-dangle": ["error", { "allow": ["__ALCHEMY_RUNTIME__"] }],
    "max-lines": [
      "error",
      {
        "max": 200,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/apps/*", "@starter/infra"],
            "message": "Application and infrastructure code must not be imported into reusable packages."
          }
        ]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.alchemy/**",
    "**/.turbo/**",
    "var/**"
  ],
  "overrides": [
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "alchemy",
                  "alchemy/*",
                  "@starter/auth",
                  "@starter/api",
                  "@starter/infra",
                  "@cloudflare/*",
                  "@starter/auth/*",
                  "@starter/api/*",
                  "@starter/infra/*",
                  "@alchemy.run/*"
                ],
                "message": "Keep cloud credentials and server code out of the browser."
              }
            ]
          }
        ],
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "react/react-in-jsx-scope": "off",
        "shadcn/no-raw-colors": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": "error"
      },
      "plugins": ["react", "react-perf", "jsx-a11y"]
    }
  ]
}
