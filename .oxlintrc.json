{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn", "oxc"],
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/consistent-type-imports": "error",
    "eqeqeq": "error",
    "max-lines": [
      "error",
      {
        "max": 200,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/apps/*", "@highchat/infra"],
            "message": "Application and infrastructure code must not be imported into reusable packages."
          }
        ]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ]
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.turbo/**", "var/**"],
  "overrides": [
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "alchemy",
                  "alchemy/*",
                  "@highchat/auth",
                  "@highchat/api",
                  "@highchat/infra",
                  "@cloudflare/*",
                  "@highchat/auth/*",
                  "@highchat/api/*",
                  "@highchat/infra/*",
                  "@highchat/integrations",
                  "@highchat/integrations/*",
                  "@highchat/config/stage",
                  "**/packages/integrations/**",
                  "@alchemy.run/*"
                ],
                "message": "Keep cloud credentials and server code out of the browser."
              }
            ]
          }
        ],
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "react/react-in-jsx-scope": "off",
        "shadcn/no-raw-colors": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": "error"
      },
      "plugins": ["react", "react-perf", "jsx-a11y"]
    },
    {
      "files": [
        "apps/web/src/components/public/**/*.tsx",
        "apps/web/src/components/auth-page.tsx",
        "apps/web/src/components/auth-form.tsx",
        "apps/web/src/components/auth-panel.tsx"
      ],
      "rules": {
        "shadcn/no-unknown-classes": [
          "error",
          {
            "message": "Unknown class {{className}}. Public classes must exist in the lazy-loaded public/styles stylesheet graph.",
            "allow": [
              "account",
              "account-intro",
              "actions",
              "art",
              "back",
              "back-top",
              "brand",
              "chapter",
              "closing",
              "closing-C",
              "closing-actions",
              "closing-footer",
              "closing-intro",
              "content",
              "deck-controls",
              "description",
              "details",
              "direction-B",
              "eyebrow",
              "feedback",
              "field",
              "fields",
              "flow-controls",
              "graphic",
              "hero",
              "hint",
              "intro",
              "invite",
              "invite-actions",
              "invite-title",
              "landing-closing",
              "landing-hero",
              "landing-workflow",
              "landing-workspace",
              "link-content",
              "mobile-B",
              "number",
              "orbital-line",
              "page",
              "password-field",
              "password-visibility",
              "pillar",
              "pillar-0",
              "pillar-1",
              "pillar-2",
              "pillars",
              "primary",
              "public-auth",
              "public-site",
              "scroll-note",
              "secondary",
              "section",
              "section-heading",
              "session-status",
              "shader",
              "shader-error",
              "shader-field",
              "shader-live",
              "shader-root",
              "shader-shade",
              "shader-surface",
              "sign-in",
              "skip",
              "spinner",
              "step",
              "step-index",
              "story",
              "success",
              "support",
              "switch",
              "variant-B",
              "visual",
              "visual-shade",
              "words",
              "workflow-C"
            ]
          }
        ]
      }
    }
  ]
}
